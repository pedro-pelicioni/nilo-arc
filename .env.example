OPENAI_API_KEY=
# Optional: override the extraction model
# OPENAI_MODEL=gpt-5.4-mini
# Optional: voice mode (GPT-Live). The backend model defaults to OPENAI_MODEL; the voice to marin
# OPENAI_VOICE_BACKEND_MODEL=gpt-5.4-mini
# OPENAI_VOICE=marin
# Optional: only these wallets (comma-separated 0x… addresses) may use voice mode; unset = any connected wallet
# VOICE_ALLOWED_ADDRESSES=

# Which Arc network: testnet (default) or mainnet. The server reads ARC_NETWORK; the web bundle VITE_ARC_NETWORK.
ARC_NETWORK=testnet
VITE_ARC_NETWORK=testnet
# Optional: another Arc RPC (e.g. a node provider) for the server.
# ARC_RPC_URL=

# Server-side only (never VITE_). Nilo's operator: the only key NiloAgent lets call `invest`, and the
# relayer that submits gasless claims (it pays their gas in USDC). It can never move funds anywhere
# but into vaults the user signed for, with the shares minted to the user.
NILO_OPERATOR_KEY=
# How often the agent checks every wallet with a mandate, in minutes.
# AGENT_INTERVAL_MINUTES=60
# Where the agent keeps its activity log (a JSON file).
# DATA_DIR=data
